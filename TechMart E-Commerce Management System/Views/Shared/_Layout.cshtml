<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TechMart</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <!-- ========================= -->
    <!-- Navbar -->
    <!-- ========================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">

        <div class="container-fluid">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-shop me-2"></i>

                TechMart

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <!-- ========================= -->
                <!-- Left Menu -->
                <!-- ========================= -->

                <ul class="navbar-nav me-auto">

                    <!-- Dashboard -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-speedometer2 me-1"></i>

                            Dashboard

                        </a>

                    </li>

                    <!-- Profile -->
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Profile"
                               asp-action="Index">

                                <i class="bi bi-person-circle me-1"></i>

                                Profile

                            </a>

                        </li>
                    }

                    <!-- Super Admin -->
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-shield-lock me-1"></i>

                                Administration

                            </a>

                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="AdminList">

                                        <i class="bi bi-people me-2"></i>

                                        Admin List

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="CreateAdmin">

                                        <i class="bi bi-person-plus me-2"></i>

                                        Create Admin

                                    </a>

                                </li>

                            </ul>

                        </li>
                    }

                    <!-- Catalog -->
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-tags me-1"></i>

                                Catalog

                            </a>

                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Catagory"
                                       asp-action="Index">

                                        <i class="bi bi-folder me-2"></i>

                                        Categories

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item disabled">

                                        <i class="bi bi-bookmark me-2"></i>

                                        Brands

                                        <small class="text-muted">

                                            (Coming Soon)

                                        </small>

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item disabled">

                                        <i class="bi bi-box me-2"></i>

                                        Products

                                        <small class="text-muted">

                                            (Coming Soon)

                                        </small>

                                    </a>

                                </li>

                            </ul>

                        </li>
                    }

                </ul>

                <!-- ========================= -->
                <!-- Right Menu -->
                <!-- ========================= -->

                <ul class="navbar-nav">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item">

                            <span class="nav-link">

                                <i class="bi bi-person-circle me-1"></i>

                                @User.Identity.Name

                            </span>

                        </li>

                        <li class="nav-item">

                            <form asp-controller="Auth"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button class="btn btn-warning btn-sm ms-2">

                                    <i class="bi bi-box-arrow-right"></i>

                                    Logout

                                </button>

                            </form>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Auth"
                               asp-action="Login">

                                Login

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Auth"
                               asp-action="Register">

                                Register

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <!-- ========================= -->
    <!-- Main Content -->
    <!-- ========================= -->

    <main class="container-fluid mt-4 mb-5">

        @RenderBody()

    </main>

    <!-- ========================= -->
    <!-- Footer -->
    <!-- ========================= -->

    <footer class="border-top text-center text-muted py-3">

        © @DateTime.Now.Year - TechMart E-Commerce Management System

    </footer>

    <!-- ========================= -->
    <!-- Scripts -->
    <!-- ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>